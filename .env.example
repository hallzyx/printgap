# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Real environment variables override this file.

# REQUIRED. Identifies you to the SEC (fair-access policy). Use a real contact email.
EDGAR_UA=PrintGap Your Name you@example.com

# Model key: set ONE of these (without any, only cached extractions are used).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
# Any other OpenAI-compatible endpoint: LLM_API_KEY plus PRINTGAP_BASE_URL and PRINTGAP_MODEL.
LLM_API_KEY=

# Optional.
# PRINTGAP_PROVIDER=openai        # anthropic | openai | deepseek | qwen | compatible
# PRINTGAP_MODEL=gpt-6-luna
# PRINTGAP_BASE_URL=              # qwen or compatible only
# PRINTGAP_SINCE=2026-03-01

# Server (python -m pg.serve)
# PRINTGAP_ADMIN_TOKEN=           # long random string; enables POST /api/refresh (disabled when empty)
# PRINTGAP_REFRESH_HOURS=0        # refresh the data on a timer, 0 = off
# PRINTGAP_ASK_PER_HOUR=20        # chat questions per client per hour
# PRINTGAP_ASK_PER_DAY=300        # chat questions per day for the whole site
# PRINTGAP_TRUST_PROXY=1          # only behind your own reverse proxy: read the client address from X-Forwarded-For
